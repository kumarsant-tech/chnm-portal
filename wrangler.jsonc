{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chnm-portal",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@netlify/blobs": "./cloudflare/netlify-blobs-unavailable.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chnm-portal",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
