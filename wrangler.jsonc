{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chnm-portal",
  "main": "cloudflare/worker.mjs",
  "vars": {
    "EMAIL_FROM": "Future Instructor <notice@futureinstructor.in>"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "futureinstructor.in", "custom_domain": true },
    { "pattern": "www.futureinstructor.in", "custom_domain": true }
  ],
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chnm-portal",
      "database_id": "b5f45c14-3e4d-440b-8b75-b7ebb14140b2",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
